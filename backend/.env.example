# Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → your project → Project Settings → API
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Admin Auth ────────────────────────────────────────────────────────────────
# Used to protect write endpoints. Set a strong random string in production.
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_API_KEY=your_strong_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, replace localhost URLs with your Vercel deployment URLs.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-calendar-app.vercel.app,https://your-admin-app.vercel.app
